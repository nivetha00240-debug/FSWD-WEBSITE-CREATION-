<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>ShopSwap - Buy & Sell</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, sans-serif;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            background: #f5f6fa;
            color: #222;
        }

        /* NAVBAR */
        nav {
            background: #4f46e5;
            color: white;
            padding: 18px 7%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        .logo {
            font-size: 27px;
            font-weight: bold;
        }

        nav ul {
            display: flex;
            list-style: none;
            gap: 25px;
        }

        nav ul a {
            color: white;
            text-decoration: none;
            font-weight: bold;
        }

        nav ul a:hover {
            color: #ddd;
        }

        .sell-nav-btn {
            background: white;
            color: #4f46e5;
            border: none;
            padding: 10px 18px;
            border-radius: 20px;
            font-weight: bold;
            cursor: pointer;
        }

        /* HERO */
        .hero {
            min-height: 430px;
            padding: 70px 8%;
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: linear-gradient(135deg, #e8e7ff, #ffffff);
        }

        .hero-text {
            max-width: 600px;
        }

        .hero-text h1 {
            font-size: 55px;
            color: #4f46e5;
            margin-bottom: 15px;
        }

        .hero-text h2 {
            font-size: 28px;
            margin-bottom: 15px;
        }

        .hero-text p {
            color: #666;
            font-size: 18px;
            margin-bottom: 25px;
        }

        .hero-btn {
            border: none;
            background: #4f46e5;
            color: white;
            padding: 14px 28px;
            border-radius: 25px;
            cursor: pointer;
            font-size: 16px;
        }

        .hero-btn:hover {
            background: #3730a3;
        }

        .hero-icon {
            font-size: 160px;
        }

        /* SECTIONS */
        section {
            padding: 60px 7%;
        }

        .section-title {
            text-align: center;
            color: #4f46e5;
            font-size: 35px;
            margin-bottom: 30px;
        }

        /* SEARCH */
        .search {
            max-width: 650px;
            margin: auto;
        }

        .search input {
            width: 100%;
            padding: 15px;
            border: 1px solid #ddd;
            border-radius: 30px;
            font-size: 16px;
            outline: none;
        }

        /* CATEGORIES */
        .categories {
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
            gap: 10px;
            margin: 25px 0;
        }

        .category-btn {
            border: none;
            padding: 10px 18px;
            border-radius: 20px;
            background: #e5e7eb;
            cursor: pointer;
        }

        .category-btn:hover,
        .category-btn.active {
            background: #4f46e5;
            color: white;
        }

        /* PRODUCTS */
        .products {
            max-width: 1200px;
            margin: auto;
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 22px;
        }

        .product {
            background: white;
            border-radius: 15px;
            overflow: hidden;
            box-shadow: 0 4px 15px rgba(0,0,0,0.08);
            transition: 0.3s;
        }

        .product:hover {
            transform: translateY(-6px);
        }

        .product-image {
            height: 150px;
            background: #eeeeff;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 75px;
        }

        .product-content {
            padding: 18px;
        }

        .product h3 {
            color: #333;
            margin-bottom: 7px;
        }

        .product p {
            color: #777;
            font-size: 14px;
            margin-bottom: 10px;
        }

        .price {
            font-size: 20px;
            color: #4f46e5;
            font-weight: bold;
            margin-bottom: 12px;
        }

        .buy-btn {
            width: 100%;
            padding: 10px;
            border: none;
            border-radius: 8px;
            background: #4f46e5;
            color: white;
            cursor: pointer;
        }

        .buy-btn:hover {
            background: #3730a3;
        }

        /* SELL FORM */
        .sell-box {
            max-width: 700px;
            margin: auto;
            background: white;
            padding: 30px;
            border-radius: 15px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.08);
        }

        .sell-box input,
        .sell-box select,
        .sell-box textarea {
            width: 100%;
            padding: 13px;
            margin-bottom: 15px;
            border: 1px solid #ddd;
            border-radius: 8px;
            outline: none;
        }

        .sell-box textarea {
            height: 100px;
            resize: none;
        }

        .sell-btn {
            width: 100%;
            padding: 13px;
            border: none;
            background: #4f46e5;
            color: white;
            border-radius: 8px;
            cursor: pointer;
            font-size: 16px;
        }

        /* CART */
        .cart {
            max-width: 850px;
            margin: auto;
            background: white;
            padding: 25px;
            border-radius: 15px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.08);
        }

        .cart-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid #eee;
            padding: 15px 0;
            gap: 10px;
        }

        .quantity button {
            border: none;
            background: #4f46e5;
            color: white;
            width: 30px;
            height: 30px;
            border-radius: 5px;
            cursor: pointer;
        }

        .quantity span {
            padding: 0 10px;
        }

        .remove {
            border: none;
            background: #555;
            color: white;
            padding: 7px 12px;
            border-radius: 5px;
            cursor: pointer;
        }

        .total {
            text-align: right;
            margin-top: 20px;
            font-size: 24px;
            color: #4f46e5;
            font-weight: bold;
        }

        .checkout {
            display: block;
            margin: 20px 0 0 auto;
            border: none;
            background: #16a34a;
            color: white;
            padding: 13px 25px;
            border-radius: 25px;
            cursor: pointer;
        }

        .empty {
            text-align: center;
            color: #777;
            padding: 20px;
        }

        /* ABOUT */
        .about {
            max-width: 850px;
            margin: auto;
            text-align: center;
            color: #666;
            font-size: 18px;
            line-height: 1.8;
        }

        /* FOOTER */
        footer {
            background: #222;
            color: white;
            text-align: center;
            padding: 25px;
        }

        footer span {
            color: #818cf8;
        }

        /* MOBILE */
        @media(max-width: 900px) {
            .products {
                grid-template-columns: repeat(2, 1fr);
            }

            .hero {
                flex-direction: column;
                text-align: center;
                gap: 30px;
            }

            .hero-text h1 {
                font-size: 42px;
            }
        }

        @media(max-width: 600px) {
            nav {
                flex-direction: column;
                gap: 15px;
            }

            nav ul {
                flex-wrap: wrap;
                justify-content: center;
                gap: 12px;
            }

            .products {
                grid-template-columns: 1fr;
            }

            .hero-icon {
                font-size: 100px;
            }

            .cart-item {
                flex-direction: column;
                align-items: flex-start;
            }

            .total {
                text-align: center;
            }

            .checkout {
                margin: 20px auto 0;
            }
        }
    </style>
</head>

<body>

    <!-- NAVIGATION -->

    <nav>

        <div class="logo">
            🛍️ ShopSwap
        </div>

        <ul>
            <li><a href="#home">Home</a></li>
            <li><a href="#products">Products</a></li>
            <li><a href="#sell">Sell</a></li>
            <li><a href="#cart">Cart</a></li>
        </ul>

        <button class="sell-nav-btn"
                onclick="goToSell()">
            Sell Item
        </button>

    </nav>


    <!-- HERO -->

    <section class="hero" id="home">

        <div class="hero-text">

            <h1>ShopSwap</h1>

            <h2>Buy & Sell Anything Easily</h2>

            <p>
                A simple online marketplace where users can
                discover products, buy items and sell their
                unwanted products.
            </p>

            <button class="hero-btn"
                    onclick="goToProducts()">
                Start Shopping 🛒
            </button>

        </div>

        <div class="hero-icon">
            🛍️
        </div>

    </section>


    <!-- PRODUCTS -->

    <section id="products">

        <h2 class="section-title">
            Available Products
        </h2>

        <!-- SEARCH -->

        <div class="search">

            <input
                type="text"
                id="search"
                placeholder="🔍 Search products..."
                onkeyup="searchProducts()"
            >

        </div>


        <!-- CATEGORIES -->

        <div class="categories">

            <button class="category-btn active"
                    onclick="filterProducts('all', this)">
                All
            </button>

            <button class="category-btn"
                    onclick="filterProducts('electronics', this)">
                📱 Electronics
            </button>

            <button class="category-btn"
                    onclick="filterProducts('fashion', this)">
                👕 Fashion
            </button>

            <button class="category-btn"
                    onclick="filterProducts('books', this)">
                📚 Books
            </button>

            <button class="category-btn"
                    onclick="filterProducts('home', this)">
                🏠 Home
            </button>

        </div>


        <!-- PRODUCT LIST -->

        <div class="products" id="productContainer">

            <div class="product"
                 data-category="electronics">

                <div class="product-image">
                    📱
                </div>

                <div class="product-content">

                    <h3>Smartphone</h3>

                    <p>Good condition smartphone</p>

                    <div class="price">₹12,999</div>

                    <button class="buy-btn"
                            onclick="addToCart('Smartphone',12999)">
                        Add to Cart
                    </button>

                </div>

            </div>


            <div class="product"
                 data-category="electronics">

                <div class="product-image">
                    💻
                </div>

                <div class="product-content">

                    <h3>Laptop</h3>

                    <p>Used laptop in good condition</p>

                    <div class="price">₹35,000</div>

                    <button class="buy-btn"
                            onclick="addToCart('Laptop',35000)">
                        Add to Cart
                    </button>

                </div>

            </div>


            <div class="product"
                 data-category="fashion">

                <div class="product-image">
                    👟
                </div>

                <div class="product-content">

                    <h3>Running Shoes</h3>

                    <p>Comfortable sports shoes</p>

                    <div class="price">₹1,299</div>

                    <button class="buy-btn"
                            onclick="addToCart('Running Shoes',1299)">
                        Add to Cart
                    </button>

                </div>

            </div>


            <div class="product"
                 data-category="fashion">

                <div class="product-image">
                    👕
                </div>

                <div class="product-content">

                    <h3>Casual Shirt</h3>

                    <p>Stylish cotton shirt</p>

                    <div class="price">₹699</div>

                    <button class="buy-btn"
                            onclick="addToCart('Casual Shirt',699)">
                        Add to Cart
                    </button>

                </div>

            </div>


            <div class="product"
                 data-category="books">

                <div class="product-image">
                    📚
                </div>

                <div class="product-content">

                    <h3>Programming Book</h3>

                    <p>Learn programming fundamentals</p>

                    <div class="price">₹450</div>

                    <button class="buy-btn"
                            onclick="addToCart('Programming Book',450)">
                        Add to Cart
                    </button>

                </div>

            </div>


            <div class="product"
                 data-category="books">

                <div class="product-image">
                    📖
                </div>

                <div class="product-content">

                    <h3>Novel</h3>

                    <p>Interesting fiction novel</p>

                    <div class="price">₹300</div>

                    <button class="buy-btn"
                            onclick="addToCart('Novel',300)">
                        Add to Cart
                    </button>

                </div>

            </div>


            <div class="product"
                 data-category="home">

                <div class="product-image">
                    🪑
                </div>

                <div class="product-content">

                    <h3>Study Chair</h3>

                    <p>Comfortable study chair</p>

                    <div class="price">₹1,500</div>

                    <button class="buy-btn"
                            onclick="addToCart('Study Chair',1500)">
                        Add to Cart
                    </button>

                </div>

            </div>


            <div class="product"
                 data-category="home">

                <div class="product-image">
                    🎧
                </div>

                <div class="product-content">

                    <h3>Headphones</h3>

                    <p>Wireless headphones</p>

                    <div class="price">₹999</div>

                    <button class="buy-btn"
                            onclick="addToCart('Headphones',999)">
                        Add to Cart
                    </button>

                </div>

            </div>

        </div>

    </section>


    <!-- SELL SECTION -->

    <section id="sell">

        <h2 class="section-title">
            Sell Your Product
        </h2>

        <div class="sell-box">

            <input
                type="text"
                id="sellerName"
                placeholder="Your Name"
            >

            <input
                type="text"
                id="productName"
                placeholder="Product Name"
            >

            <select id="productCategory">

                <option value="">
                    Select Category
                </option>

                <option value="electronics">
                    Electronics
                </option>

                <option value="fashion">
                    Fashion
                </option>

                <option value="books">
                    Books
                </option>

                <option value="home">
                    Home
                </option>

            </select>

            <input
                type="number"
                id="productPrice"
                placeholder="Product Price ₹"
            >

            <textarea
                id="productDescription"
                placeholder="Product Description">
            </textarea>

            <button class="sell-btn"
                    onclick="sellProduct()">
                List Product for Sale
            </button>

        </div>

    </section>


    <!-- CART -->

    <section id="cart">

        <h2 class="section-title">
            🛒 Shopping Cart
        </h2>

        <div class="cart">

            <div id="cartItems">

                <div class="empty">
                    Your cart is empty.
                </div>

            </div>

            <div class="total">
                Total: ₹<span id="total">0</span>
            </div>

            <button class="checkout"
                    onclick="checkout()">
                Buy Now
            </button>

        </div>

    </section>


    <!-- ABOUT -->

    <section>

        <h2 class="section-title">
            About ShopSwap
        </h2>

        <div class="about">

            <p>
                ShopSwap is a simple buy-and-sell marketplace
                application. Users can browse products, search
                products, filter by category, add products to a
                shopping cart and list their own products for sale.
            </p>

        </div>

    </section>


    <!-- FOOTER -->

    <footer>

        <p>
            © 2026 <span>ShopSwap</span>
            | Buy • Sell • Connect
        </p>

    </footer>


    <script>

        /* CART */

        let cart = [];


        /* ADD TO CART */

        function addToCart(name, price) {

            const existing =
                cart.find(item => item.name === name);

            if (existing) {

                existing.quantity++;

            } else {

                cart.push({
                    name: name,
                    price: price,
                    quantity: 1
                });

            }

            updateCart();

            alert(name + " added to cart!");

        }


        /* UPDATE CART */

        function updateCart() {

            const cartItems =
                document.getElementById("cartItems");

            const totalElement =
                document.getElementById("total");

            cartItems.innerHTML = "";

            let total = 0;


            if (cart.length === 0) {

                cartItems.innerHTML =
                    '<div class="empty">Your cart is empty.</div>';

            }


            cart.forEach(function(item, index) {

                total +=
                    item.price * item.quantity;


                const div =
                    document.createElement("div");

                div.className = "cart-item";


                div.innerHTML = `

                    <div>
