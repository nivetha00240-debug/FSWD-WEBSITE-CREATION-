<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>ShopEasy - Buy & Sell</title>

<style>

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: Arial, sans-serif;
    background: #f5f7fb;
    color: #222;
}

/* NAVBAR */

nav {
    background: #2563eb;
    color: white;
    padding: 18px 7%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    position: sticky;
    top: 0;
    z-index: 1000;
}

.logo {
    font-size: 27px;
    font-weight: bold;
}

nav ul {
    display: flex;
    list-style: none;
    gap: 25px;
}

nav ul a {
    color: white;
    text-decoration: none;
    font-weight: bold;
}

nav ul a:hover {
    color: #dbeafe;
}

.cart-button {
    background: white;
    color: #2563eb;
    border: none;
    padding: 10px 18px;
    border-radius: 25px;
    cursor: pointer;
    font-weight: bold;
}

/* HERO */

.hero {
    min-height: 480px;
    padding: 70px 8%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: linear-gradient(135deg, #dbeafe, #ffffff);
}

.hero-text {
    max-width: 600px;
}

.hero-text h1 {
    font-size: 58px;
    color: #2563eb;
    margin-bottom: 15px;
}

.hero-text h2 {
    font-size: 30px;
    margin-bottom: 15px;
}

.hero-text p {
    color: #666;
    font-size: 18px;
    line-height: 1.7;
    margin-bottom: 25px;
}

.hero-btn {
    background: #2563eb;
    color: white;
    border: none;
    padding: 14px 28px;
    border-radius: 25px;
    cursor: pointer;
    font-size: 16px;
}

.hero-btn:hover {
    background: #1d4ed8;
}

.hero-icon {
    font-size: 160px;
}

/* SECTION */

section {
    padding: 60px 7%;
}

.section-title {
    text-align: center;
    color: #2563eb;
    font-size: 36px;
    margin-bottom: 35px;
}

/* SEARCH */

.search-box {
    max-width: 650px;
    margin: auto;
}

.search-box input {
    width: 100%;
    padding: 15px 20px;
    border: 1px solid #ddd;
    border-radius: 30px;
    font-size: 16px;
    outline: none;
}

/* CATEGORIES */

.categories {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 12px;
    margin: 25px 0 35px;
}

.category {
    border: none;
    padding: 10px 20px;
    border-radius: 25px;
    background: #e5e7eb;
    cursor: pointer;
}

.category.active,
.category:hover {
    background: #2563eb;
    color: white;
}

/* PRODUCTS */

.products {
    max-width: 1200px;
    margin: auto;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 22px;
}

.product {
    background: white;
    border-radius: 15px;
    overflow: hidden;
    box-shadow: 0 4px 15px rgba(0,0,0,0.08);
    transition: 0.3s;
}

.product:hover {
    transform: translateY(-6px);
}

.product-image {
    height: 160px;
    background: #eff6ff;
    display: flex;
    justify-content: center;
    align-items: center;
    font-size: 80px;
}

.product-content {
    padding: 18px;
}

.product-content h3 {
    margin-bottom: 8px;
}

.product-content p {
    color: #777;
    font-size: 14px;
    margin-bottom: 10px;
}

.price {
    color: #2563eb;
    font-size: 21px;
    font-weight: bold;
    margin-bottom: 12px;
}

.buy-btn {
    width: 100%;
    border: none;
    background: #2563eb;
    color: white;
    padding: 11px;
    border-radius: 8px;
    cursor: pointer;
}

.buy-btn:hover {
    background: #1d4ed8;
}

/* SELL */

.sell-section {
    background: white;
}

.sell-box {
    max-width: 700px;
    margin: auto;
    padding: 30px;
    border-radius: 15px;
    box-shadow: 0 5px 20px rgba(0,0,0,0.08);
}

.sell-box input,
.sell-box select,
.sell-box textarea {
    width: 100%;
    padding: 13px;
    margin-bottom: 15px;
    border: 1px solid #ddd;
    border-radius: 8px;
    outline: none;
}

.sell-box textarea {
    height: 110px;
    resize: none;
}

.sell-btn {
    width: 100%;
    border: none;
    background: #2563eb;
    color: white;
    padding: 13px;
    border-radius: 8px;
    cursor: pointer;
    font-size: 16px;
}

/* CART */

.cart-box {
    max-width: 850px;
    margin: auto;
    background: white;
    padding: 25px;
    border-radius: 15px;
    box-shadow: 0 5px 20px rgba(0,0,0,0.08);
}

.cart-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 15px;
    padding: 15px 0;
    border-bottom: 1px solid #eee;
}

.quantity button {
    width: 30px;
    height: 30px;
    border: none;
    background: #2563eb;
    color: white;
    border-radius: 5px;
    cursor: pointer;
}

.quantity span {
    padding: 0 10px;
}

.remove-btn {
    border: none;
    background: #555;
    color: white;
    padding: 7px 12px;
    border-radius: 5px;
    cursor: pointer;
}

.total {
    text-align: right;
    margin-top: 20px;
    color: #2563eb;
    font-size: 25px;
    font-weight: bold;
}

.checkout {
    display: block;
    margin: 20px 0 0 auto;
    background: #16a34a;
    color: white;
    border: none;
    padding: 13px 25px;
    border-radius: 25px;
    cursor: pointer;
}

/* ABOUT */

.about {
    max-width: 850px;
    margin: auto;
    text-align: center;
}

.about p {
    color: #666;
    font-size: 18px;
    line-height: 1.8;
}

/* FOOTER */

footer {
    background: #222;
    color: white;
    text-align: center;
    padding: 25px;
}

footer span {
    color: #60a5fa;
}

/* MOBILE */

@media(max-width: 900px) {

    .products {
        grid-template-columns: repeat(2, 1fr);
    }

    .hero {
        flex-direction: column;
        text-align: center;
        gap: 30px;
    }

    nav {
        flex-direction: column;
        gap: 15px;
    }

}

@media(max-width: 600px) {

    .products {
        grid-template-columns: 1fr;
    }

    nav ul {
        flex-wrap: wrap;
        justify-content: center;
        gap: 12px;
    }

    .hero-text h1 {
        font-size: 42px;
    }

    .hero-icon {
        font-size: 100px;
    }

    .cart-item {
        flex-direction: column;
        align-items: flex-start;
    }

    .total {
        text-align: center;
    }

    .checkout {
        margin: 20px auto 0;
    }
}

</style>
</head>

